# Host ports the compose stack publishes. Every one is overridable, because
# 27017, 4566, 9090 and 3000 in particular are usually already taken on a
# machine that has run anything else. Only the host side moves -- inside the
# compose network the services still reach each other on the standard ports,
# so nothing else needs changing.
#
# Copy this to .env, or set them inline: `GRAFANA_HOST_PORT=3001 make up`.

POSTGRES_HOST_PORT=5434
MONGO_HOST_PORT=27017
LOCALSTACK_HOST_PORT=4566
ORDER_SERVICE_HOST_PORT=8080
INVENTORY_SERVICE_HOST_PORT=8081
NOTIFICATION_SERVICE_HOST_PORT=8082
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
